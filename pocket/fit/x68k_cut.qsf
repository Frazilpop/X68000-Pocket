# The board alone, every port a virtual pin, on the Pocket's part: what the cuts leave, before the shell.
set_global_assignment -name FAMILY "Cyclone V"
set_global_assignment -name DEVICE 5CEBA4F23C8
set_global_assignment -name TOP_LEVEL_ENTITY X68K_top
set_global_assignment -name PROJECT_OUTPUT_DIRECTORY output_files
set_global_assignment -name NUM_PARALLEL_PROCESSORS 1
set_global_assignment -name OPTIMIZATION_MODE "HIGH PERFORMANCE EFFORT"
set_global_assignment -name SDC_FILE x68k_cut.sdc
set_global_assignment -name QIP_FILE rtl/x68k.qip
set_instance_assignment -name VIRTUAL_PIN ON -to scan_ready*
